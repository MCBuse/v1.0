{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "src",
  "testRegex": ".*(?<!devnet-int)\\.int-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "testTimeout": 60000,
  "moduleNameMapper": {
    "^archiver$": "<rootDir>/database/testing/archiver-stub.ts"
  }
}