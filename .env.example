# Local Cloud Run deployment defaults.
# Copy this file to .env.local. That local file is ignored by Git.
MCBUSE_GCP_PROJECT_ID=mcbuse-hackathon-2026-fno
MCBUSE_GCP_REGION=europe-west1

# Set this to a newly created, checksum-verified backup before a deployment
# that may run database migrations. Never commit database dumps or secret values.
# MCBUSE_BACKUP_DIR=/absolute/path/to/verified-pre-migration-backup
