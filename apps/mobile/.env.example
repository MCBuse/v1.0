# Optional override. Leave unset for Expo dev builds so the app can infer the
# LAN host from the Expo dev server. For physical devices, this must be your
# computer's LAN IP, not localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.124:4000/api/v1
EXPO_PUBLIC_ONRAMP_REDIRECT_URL=mcbuse://onramp/complete
