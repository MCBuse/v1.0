{
  "name": "v1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:push": "pnpm --filter api db:push",
    "deploy:api": "pnpm deploy:api:cloud-run",
    "deploy:api:cloud-run:bootstrap": "bash scripts/cloud-run/bootstrap.sh",
    "deploy:api:cloud-run": "bash scripts/cloud-run/deploy.sh",
    "deploy:portal:cloud-run": "bash scripts/cloud-run/deploy-portal.sh",
    "dev:api": "pnpm --filter api start:dev",
    "dev:portal": "pnpm --filter portal dev",
    "test:portal": "pnpm --filter portal test && pnpm --filter portal test:e2e"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18"
  }
}
