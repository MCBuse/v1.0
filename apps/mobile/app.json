{
  "expo": {
    "name": "MCBuse",
    "slug": "mcbuse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mcbuse",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.f-o-nyarko.mcbuse",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan QR codes and process transactions.",
        "NSPhotoLibraryUsageDescription": "Allow access to upload payment proofs or profile images.",
        "NSMicrophoneUsageDescription": "Used for voice-based features (optional).",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.f_o_nyarko.mcbuse",
      "permissions": [
        "android.permission.NFC"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.5"
          },
          "android": {
            "compileSdkVersion": 35
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "24d4d4c3-a3fa-4088-b6f1-db39e8b0e82f"
      },
      "privyAppId": "cmp0fngli001a0bl5sxo0mo40",
      "privyClientId": "client-WY6ZMQ6YJUWqv2xrSDekGJiGqpBiRpmd28sRg3kcPPCn4"
    }
  }
}
